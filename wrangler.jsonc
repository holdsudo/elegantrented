{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rental-ledger",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat gives the Worker Node's crypto and Buffer, which Prisma,
  // bcryptjs and the session signing all rely on.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // The workers.dev URL stays on. Declaring "routes" alone silently turns it
  // off, which took every URL down once — keep this explicit.
  "workers_dev": true,

  // The app's own domain. custom_domain lets the Worker answer for the hostname
  // directly — Cloudflare creates and manages the DNS record itself — which is
  // only possible because the zone lives in the same account as the Worker.
  // Cloudflare refuses to take over a hostname that already has its own DNS
  // record, so each pattern here needs its record deleted from the zone first.
  // www still has one; add it back to this list once that record is gone.
  "routes": [
    { "pattern": "elegantrented.com", "custom_domain": true }
  ],

  // The database. `database_id` is filled in by `wrangler d1 create rental-ledger`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rental-ledger",
      "database_id": "63ce669a-ff39-40e5-934b-4f5211cf0785",
      "migrations_dir": "migrations"
    }
  ],

  // Gown photos live in D1 alongside everything else. R2 would be the better
  // home, but enabling it requires a card on file, so this account stores photos
  // in the database instead — 5 GB of D1 holds tens of thousands of them at the
  // size the browser downscaler produces.
  //
  // To move to R2 later: enable R2 on the account, create the bucket, and
  // uncomment this block. The code picks the bucket up automatically, and photos
  // already in D1 keep working because each row records how it was stored.
  //
  // "r2_buckets": [
  //   { "binding": "PHOTOS", "bucket_name": "gown-photos" }
  // ]

  // SESSION_SECRET is NOT set here — it is a secret, not config.
  // Set it once with:  npx wrangler secret put SESSION_SECRET
}
