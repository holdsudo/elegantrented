# The only variable the app needs locally is this one, and only the Prisma CLI
# reads it — at runtime the D1 binding supplies the database.
DATABASE_URL="file:./prisma/dev.db"

# Everything else is a Cloudflare binding (wrangler.jsonc), not an env var:
#   DB      -> D1 database   rental-ledger
#   PHOTOS  -> R2 bucket     gown-photos
#
# The one real secret is set on the deployed Worker, never in a file:
#   npx wrangler secret put SESSION_SECRET
